---
import type { Project } from '../data/projects';
import { withBase } from '../lib/url';
import { localePath, ui, type Lang } from '../i18n';

interface Props {
  project: Project;
  index: number;
  lang: Lang;
}

const { project: p, index, lang } = Astro.props;
const href = localePath(lang, `projects/${p.slug}/`);
const num = String(index + 1).padStart(2, '0');
const shot = p.cover ? { src: p.cover } : p.images?.[0];
---

<article class="pcard card" style={`--hue:${p.hue}`}>
  <a class:list={['cover', { 'has-shot': shot }]} href={href} aria-hidden="true" tabindex="-1">
    <span class="num">{num}</span>
    <span class="status"><span class="dot"></span>{p.status}</span>
    {
      shot ? (
        <img class="shot" src={withBase(shot.src)} alt="" loading="lazy" decoding="async" />
      ) : (
        <ul class="metrics">
          {p.metrics.slice(0, 3).map((m) => (
            <li>
              <strong>{m.value}</strong>
              <span>{m.label}</span>
            </li>
          ))}
        </ul>
      )
    }
  </a>
  <div class="body">
    <div class="eyebrow">{p.category}</div>
    <h3>
      <a href={href}>{p.title}</a>
    </h3>
    <p class="desc">{p.card}</p>
    {
      shot && (
        <ul class="bmetrics">
          {p.metrics.slice(0, 3).map((m) => (
            <li>
              <strong>{m.value}</strong>
              <span>{m.label}</span>
            </li>
          ))}
        </ul>
      )
    }
    <ul class="tags">
      {p.cardTags.map((t) => <li class="tag">{t}</li>)}
    </ul>
    <span class="more" aria-hidden="true">{ui[lang].readCase}</span>
  </div>
</article>

<style>
  .pcard {
    position: relative;
    display: grid;
    overflow: hidden;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }
  .pcard:hover {
    transform: translateY(-3px);
    border-color: color-mix(in srgb, var(--text) 30%, var(--line));
  }
  .cover {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 28px;
    padding: 22px;
    min-height: 210px;
    text-decoration: none;
    color: #f4f4f0;
    background:
      radial-gradient(120% 90% at 100% 0%, hsl(var(--hue) 70% 45% / 0.55), transparent 60%),
      radial-gradient(80% 80% at 0% 100%, hsl(calc(var(--hue) + 40) 60% 40% / 0.35), transparent 60%),
      #141619;
  }
  .cover::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgb(255 255 255 / 0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.05) 1px, transparent 1px);
    background-size: 28px 28px;
    mask-image: linear-gradient(to bottom, black, transparent 90%);
    pointer-events: none;
  }
  .num {
    position: absolute;
    top: 16px;
    right: 20px;
    font-family: var(--mono);
    font-size: 13px;
    opacity: 0.6;
  }
  .status {
    position: relative;
    z-index: 1;
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 12.5px;
    font-weight: 600;
    padding: 6px 12px;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.1);
    border: 1px solid rgb(255 255 255 / 0.14);
    max-width: calc(100% - 40px);
  }
  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #4cd9a0;
    box-shadow: 0 0 0 3px rgb(76 217 160 / 0.25);
    flex: none;
  }
  .metrics {
    position: relative;
    z-index: 1;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
  }
  .metrics li {
    display: grid;
    gap: 2px;
  }
  .metrics strong {
    font-size: clamp(20px, 2.6vw, 26px);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }
  .metrics span {
    font-size: 12.5px;
    line-height: 1.3;
    opacity: 0.72;
  }
  .cover.has-shot {
    justify-content: flex-start;
    gap: 18px;
    padding: 22px 22px 0;
    min-height: 0;
  }
  .shot {
    position: relative;
    z-index: 1;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    object-position: top left;
    border-radius: 10px 10px 0 0;
    border: 1px solid rgb(255 255 255 / 0.14);
    border-bottom: 0;
    box-shadow: 0 -6px 30px rgb(0 0 0 / 0.35);
    transition: transform 0.3s ease;
  }
  .pcard:hover .shot {
    transform: translateY(-4px);
  }
  .body :global(.bmetrics) {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    padding: 12px 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .body :global(.bmetrics li) {
    display: grid;
    gap: 2px;
  }
  .body :global(.bmetrics strong) {
    font-size: 19px;
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }
  .body :global(.bmetrics span) {
    font-size: 12.5px;
    line-height: 1.3;
    color: var(--muted);
  }
  .body {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 22px;
  }
  .body .eyebrow {
    margin: 0;
  }
  h3 {
    font-size: 23px;
    font-weight: 800;
  }
  h3 a {
    text-decoration: none;
  }
  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .desc {
    color: var(--muted);
  }
  .more {
    margin-top: auto;
    padding-top: 6px;
    font-weight: 700;
    font-size: 15px;
  }
  .pcard:hover .more {
    color: var(--accent);
  }
</style>

---
import Base from '../layouts/Base.astro';
import Diagram from './Diagram.astro';
import type { Project } from '../data/projects';
import { withBase } from '../lib/url';
import { getProfile, localePath, ui, type Lang } from '../i18n';

interface Props {
  project: Project;
  next?: Project;
  lang: Lang;
}

const { project: p, next, lang } = Astro.props;
const t = ui[lang];
const { profile } = getProfile(lang);
const isAcademic = p.kind === 'academic';
const isPhone = p.device === 'phone';

const sections = [
  { id: 'problem', label: t.problem },
  { id: 'solution', label: t.solution },
  { id: 'features', label: t.features },
  ...(p.challenges.length ? [{ id: 'challenges', label: p.challengesTitle ?? t.challenges }] : []),
  { id: 'stack', label: t.stack },
  { id: 'result', label: t.result },
];
---

<Base lang={lang} path={`projects/${p.slug}/`} title={`${p.title} — ${t.caseSuffix} | ${profile.name}`} description={p.card}>
  <article style={`--hue:${p.hue}`}>
    <header class="case-hero">
      <div class="wrap">
        <a class="back" href={localePath(lang, isAcademic ? '#academic' : '#projects')}>
          {isAcademic ? t.backAcademic : t.backAll}
        </a>
        <div class="eyebrow">{p.category}</div>
        <h1>{p.title}</h1>
        <p class="lead">{p.lead}</p>
        <dl class="meta">
          <div>
            <dt>{t.role}</dt>
            <dd>{p.role}</dd>
          </div>
          <div>
            <dt>{t.status}</dt>
            <dd>{p.status}</dd>
          </div>
          {
            p.period && (
              <div>
                <dt>{t.period}</dt>
                <dd>{p.period}</dd>
              </div>
            )
          }
          {
            (p.link || p.linkNote) && (
              <div>
                <dt>{t.link}</dt>
                <dd>
                  {p.link ? (
                    <a href={p.link.href} target="_blank" rel="noopener">
                      {p.link.label} ↗
                    </a>
                  ) : (
                    p.linkNote
                  )}
                </dd>
              </div>
            )
          }
        </dl>
        <ul class="metrics">
          {
            p.metrics.map((m) => (
              <li>
                <strong>{m.value}</strong>
                <span>{m.label}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </header>

    {
      p.images && p.images.length > 0 && (
        <section class:list={['wrap', 'gallery', { phone: isPhone }]} aria-label={t.screenshots}>
          {p.images.map((img, i) => (
            <figure class:list={[{ wide: i === 0 && !isPhone }]}>
              <a href={withBase(img.src)} target="_blank" rel="noopener" class="frame">
                {!isPhone && (
                  <span class="bar" aria-hidden="true">
                    <i></i><i></i><i></i>
                  </span>
                )}
                <img src={withBase(img.src)} alt={img.alt} loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />
              </a>
              {img.caption && <figcaption>{img.caption}</figcaption>}
            </figure>
          ))}
        </section>
      )
    }

    <div class="wrap case-body">
      <aside class="toc" aria-label={t.toc}>
        <ol>
          {
            sections.map((s) => (
              <li>
                <a href={`#${s.id}`}>{s.label}</a>
              </li>
            ))
          }
        </ol>
      </aside>

      <div class="content">
        <section id="problem">
          <h2>{t.problem}</h2>
          <ul class="bullets">{p.problem.map((t) => <li>{t}</li>)}</ul>
        </section>

        <section id="solution">
          <h2>{t.solution}</h2>
          {p.solution.map((t) => <p class="para">{t}</p>)}
          <div class="diagrams">
            {p.diagrams.map((d) => <Diagram diagram={d} />)}
          </div>
        </section>

        <section id="features">
          <h2>{t.features}</h2>
          <div class="features">
            {
              p.features.map((f) => (
                <div class="feature">
                  <h3>{f.title}</h3>
                  <ul class="bullets">
                    {f.items.map((t) => (
                      <li>{t}</li>
                    ))}
                  </ul>
                  {f.note && <p class="fnote">{f.note}</p>}
                </div>
              ))
            }
          </div>
        </section>

        {
          p.challenges.length > 0 && (
            <section id="challenges">
              <h2>{p.challengesTitle ?? t.challenges}</h2>
              <ol class="challenges">
                {p.challenges.map((c, i) => (
                  <li class="card">
                    <span class="cnum">{String(i + 1).padStart(2, '0')}</span>
                    <h3>{c.title}</h3>
                    <p>{c.text}</p>
                  </li>
                ))}
              </ol>
            </section>
          )
        }

        <section id="stack">
          <h2>{t.stack}</h2>
          <div class="stack">
            {
              p.stack.map((g) => (
                <div class="stack-row">
                  <h3>{g.group}</h3>
                  <ul class="tags">
                    {g.items.map((t) => (
                      <li class="tag">{t}</li>
                    ))}
                  </ul>
                </div>
              ))
            }
          </div>
        </section>

        <section id="result">
          <h2>{t.result}</h2>
          <ul class="results">
            {
              p.results.map((r) => (
                <li>
                  <span class="check" aria-hidden="true">✓</span>
                  {r}
                </li>
              ))
            }
          </ul>
        </section>

        {
          next ? (
            <a class="next card" href={localePath(lang, `projects/${next.slug}/`)}>
              <span class="next-label">{t.nextProject}</span>
              <span class="next-title">{next.title} →</span>
            </a>
          ) : (
            <a class="next card" href={localePath(lang, '#projects')}>
              <span class="next-label">{t.portfolio}</span>
              <span class="next-title">{t.commercialProjects}</span>
            </a>
          )
        }
      </div>
    </div>
  </article>
</Base>

<style>
  .case-hero {
    position: relative;
    padding: 40px 0 48px;
    color: #f4f4f0;
    background:
      radial-gradient(90% 120% at 100% 0%, hsl(var(--hue) 70% 42% / 0.5), transparent 60%),
      radial-gradient(60% 80% at 0% 100%, hsl(calc(var(--hue) + 40) 60% 38% / 0.3), transparent 60%),
      #121417;
    overflow: hidden;
  }
  .case-hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgb(255 255 255 / 0.045) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.045) 1px, transparent 1px);
    background-size: 40px 40px;
    mask-image: linear-gradient(to bottom, black, transparent);
    pointer-events: none;
  }
  .case-hero .wrap {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 16px;
  }
  @media (min-width: 720px) {
    .case-hero {
      padding: 56px 0 72px;
    }
  }
  .back {
    justify-self: start;
    text-decoration: none;
    font-weight: 600;
    font-size: 14.5px;
    opacity: 0.75;
    margin-bottom: 20px;
  }
  .back:hover {
    opacity: 1;
  }
  .case-hero .eyebrow {
    color: #4cd9a0;
    margin: 0;
  }
  h1 {
    font-size: clamp(36px, 6.5vw, 68px);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.02;
    max-width: 18ch;
  }
  .lead {
    font-size: clamp(17px, 2vw, 20px);
    line-height: 1.55;
    max-width: 68ch;
    opacity: 0.85;
  }
  .meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 16px 28px;
    margin: 16px 0 0;
    padding: 20px 0;
    border-top: 1px solid rgb(255 255 255 / 0.14);
    border-bottom: 1px solid rgb(255 255 255 / 0.14);
  }
  .meta dt {
    font-family: var(--mono);
    font-size: 12px;
    text-transform: uppercase;
    opacity: 0.55;
    margin-bottom: 4px;
  }
  .meta dd {
    margin: 0;
    font-weight: 600;
    font-size: 15px;
    line-height: 1.4;
  }
  .meta a {
    color: #4cd9a0;
    text-decoration: none;
  }
  .metrics {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
    gap: 20px;
    margin-top: 12px;
  }
  .metrics li {
    display: grid;
    gap: 4px;
  }
  .metrics strong {
    font-size: clamp(26px, 3.6vw, 36px);
    font-weight: 800;
    letter-spacing: -0.025em;
    line-height: 1.05;
  }
  .metrics span {
    font-size: 13.5px;
    opacity: 0.7;
    line-height: 1.35;
  }

  .case-body {
    display: grid;
    gap: 32px;
    padding-top: 56px;
    padding-bottom: 96px;
  }
  @media (min-width: 1000px) {
    .case-body {
      grid-template-columns: 200px minmax(0, 1fr);
      gap: 64px;
    }
  }
  .toc {
    display: none;
  }
  @media (min-width: 1000px) {
    .toc {
      display: block;
    }
    .toc ol {
      position: sticky;
      top: 96px;
      list-style: none;
      margin: 0;
      padding: 0 0 0 16px;
      border-left: 2px solid var(--line);
      display: grid;
      gap: 10px;
    }
    .toc a {
      text-decoration: none;
      color: var(--muted);
      font-weight: 600;
      font-size: 14.5px;
    }
    .toc a:hover {
      color: var(--text);
    }
  }

  .content {
    display: grid;
    gap: 64px;
    min-width: 0;
  }
  .content section {
    display: grid;
    gap: 18px;
  }
  .content h2 {
    font-size: clamp(26px, 3.4vw, 34px);
    font-weight: 800;
  }
  .para {
    font-size: 17px;
    max-width: 72ch;
  }
  .content > section > .bullets {
    font-size: 17px;
    max-width: 72ch;
  }
  .diagrams {
    display: grid;
    gap: 16px;
    margin-top: 8px;
  }
  .features {
    display: grid;
    gap: 28px;
  }
  @media (min-width: 760px) {
    .features {
      grid-template-columns: 1fr 1fr;
      gap: 32px 40px;
    }
  }
  .feature h3 {
    font-size: 18px;
    font-weight: 800;
    margin-bottom: 12px;
  }
  .feature .bullets {
    color: var(--muted);
    font-size: 15.5px;
  }

  .fnote {
    margin-top: 12px;
    font-size: 14px;
    color: var(--muted);
    font-style: italic;
    padding-left: 12px;
    border-left: 2px solid var(--line);
  }

  .challenges {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 14px;
  }
  @media (min-width: 760px) {
    .challenges {
      grid-template-columns: 1fr 1fr;
    }
  }
  .challenges li {
    padding: 22px;
    display: grid;
    gap: 8px;
    align-content: start;
    box-shadow: none;
  }
  .cnum {
    font-family: var(--mono);
    font-size: 13px;
    color: var(--accent);
  }
  .challenges h3 {
    font-size: 18px;
    font-weight: 800;
  }
  .challenges p {
    color: var(--muted);
    font-size: 15.5px;
  }

  .stack {
    display: grid;
    border-top: 1px solid var(--line);
  }
  .stack-row {
    display: grid;
    gap: 10px;
    padding: 16px 0;
    border-bottom: 1px solid var(--line);
  }
  @media (min-width: 640px) {
    .stack-row {
      grid-template-columns: 170px 1fr;
      align-items: start;
    }
  }
  .stack-row h3 {
    font-size: 15px;
    font-weight: 700;
    padding-top: 4px;
  }

  .results {
    list-style: none;
    display: grid;
    gap: 12px;
  }
  .results li {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    font-size: 17px;
    padding: 16px 18px;
    border-radius: 12px;
    background: var(--accent-soft);
  }
  .check {
    display: grid;
    place-items: center;
    flex: none;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--accent);
    color: var(--accent-text);
    font-size: 13px;
    font-weight: 800;
    margin-top: 2px;
  }

  .gallery {
    position: relative;
    z-index: 2;
    display: grid;
    gap: 28px 20px;
    margin-top: -40px;
  }
  @media (min-width: 760px) {
    .gallery {
      grid-template-columns: 1fr 1fr;
      margin-top: -56px;
    }
    .gallery .wide {
      grid-column: 1 / -1;
    }
  }
  .gallery figure {
    margin: 0;
    display: grid;
    gap: 10px;
    align-content: start;
  }
  .frame {
    display: block;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--surface);
    box-shadow: 0 2px 4px rgb(0 0 0 / 0.06), 0 18px 48px rgb(0 0 0 / 0.16);
    transition: transform 0.2s ease;
  }
  .frame:hover {
    transform: translateY(-2px);
  }
  .bar {
    display: flex;
    gap: 6px;
    padding: 9px 12px;
    background: var(--surface-2);
    border-bottom: 1px solid var(--line);
  }
  .bar i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--muted) 45%, transparent);
  }
  .frame img {
    width: 100%;
    height: auto;
  }
  .gallery.phone {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px 14px;
  }
  @media (min-width: 760px) {
    .gallery.phone {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 32px 20px;
    }
  }
  .gallery.phone .frame {
    border-radius: 22px;
    border: 5px solid #121316;
    background: #121316;
  }
  .gallery.phone figcaption {
    font-size: 13.5px;
  }
  .gallery figcaption {
    color: var(--muted);
    font-size: 14.5px;
    line-height: 1.45;
    max-width: 80ch;
  }

  .next {
    display: grid;
    gap: 6px;
    padding: 24px;
    text-decoration: none;
    box-shadow: none;
    transition: border-color 0.15s ease;
  }
  .next:hover {
    border-color: var(--text);
  }
  .next-label {
    font-family: var(--mono);
    font-size: 12.5px;
    color: var(--muted);
    text-transform: uppercase;
  }
  .next-title {
    font-size: 24px;
    font-weight: 800;
    letter-spacing: -0.02em;
  }
</style>

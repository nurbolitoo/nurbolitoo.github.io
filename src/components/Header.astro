---
import { withBase } from '../lib/url';
import { getProfile, langs, localePath, ui, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  path: string;
}

const { lang, path } = Astro.props;
const t = ui[lang];
const { profile } = getProfile(lang);

const links = [
  { href: localePath(lang, '#projects'), label: t.navProjects },
  { href: localePath(lang, '#services'), label: t.navServices },
  { href: localePath(lang, '#experience'), label: t.navExperience },
];
---

<header class="header">
  <div class="wrap header-inner">
    <a class="logo" href={localePath(lang, '')} aria-label={t.homeAria}>
      <img class="logo-mark" src={withBase('logo.png')} alt="" width="34" height="34" />
      <span class="logo-text">{profile.name}</span>
    </a>
    <nav class="nav" aria-label={t.navAria}>
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
      <a class="nav-cta" href={localePath(lang, '#contact')}>{t.navContact}</a>
      <div class="lang-switch" role="group" aria-label={t.langAria}>
        {
          langs.map((l) => (
            <a
              href={localePath(l, path)}
              hreflang={l}
              lang={l}
              aria-current={l === lang ? 'true' : undefined}
              class:list={['lang', { active: l === lang }]}
            >
              {l.toUpperCase()}
            </a>
          ))
        }
      </div>
      <button class="theme-toggle" type="button" aria-label={t.themeAria}>
        <svg class="i-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
        <svg class="i-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg>
      </button>
    </nav>
  </div>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.theme-toggle');
  btn?.addEventListener('click', () => {
    const root = document.documentElement;
    const current =
      root.dataset.theme ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    const next = current === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {}
  });
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: saturate(160%) blur(12px);
    -webkit-backdrop-filter: saturate(160%) blur(12px);
    border-bottom: 1px solid color-mix(in srgb, var(--line) 70%, transparent);
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
    gap: 12px;
  }
  .logo {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    font-weight: 800;
    min-width: 0;
  }
  .logo-mark {
    width: 34px;
    height: 34px;
    flex: none;
  }
  .logo-text {
    white-space: nowrap;
  }
  .nav {
    display: flex;
    align-items: center;
    gap: 4px;
  }
  .nav a {
    text-decoration: none;
    font-size: 14.5px;
    font-weight: 600;
    color: var(--muted);
    padding: 8px 12px;
    border-radius: 999px;
    transition: color 0.15s ease;
  }
  .nav a:hover {
    color: var(--text);
  }
  .nav .nav-cta {
    color: var(--bg);
    background: var(--text);
    margin-left: 4px;
  }
  .nav .nav-cta:hover {
    color: var(--bg);
  }
  .lang-switch {
    display: flex;
    align-items: center;
    margin-left: 4px;
    padding: 3px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--surface);
  }
  .nav .lang-switch a {
    padding: 5px 9px;
    font-family: var(--mono);
    font-size: 12px;
    font-weight: 500;
    line-height: 1;
    color: var(--muted);
  }
  .nav .lang-switch a:hover {
    color: var(--text);
  }
  .nav .lang-switch a.active {
    background: var(--text);
    color: var(--bg);
  }
  .theme-toggle {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    margin-left: 4px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--text);
    cursor: pointer;
  }
  .i-moon {
    display: none;
  }
  :global(:root[data-theme='dark']) .i-sun {
    display: none;
  }
  :global(:root[data-theme='dark']) .i-moon {
    display: block;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .i-sun {
      display: none;
    }
    :global(:root:not([data-theme='light'])) .i-moon {
      display: block;
    }
  }
  @media (max-width: 760px) {
    .nav > a:not(.nav-cta) {
      display: none;
    }
  }
  @media (max-width: 420px) {
    .logo-text {
      display: none;
    }
  }
</style>

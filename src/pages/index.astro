---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { profile, services, skills, experience, academic } from '../data/profile';
import { projects } from '../data/projects';
import { withBase } from '../lib/url';

const c = profile.contacts;
const commercial = projects.filter((p) => (p.kind ?? 'commercial') === 'commercial');
const academicCases = projects.filter((p) => p.kind === 'academic');
// Экраны для миниатюр на карточке учебного кейса
const thumbsFor = (p: (typeof projects)[number]) =>
  (p.images ?? []).filter((img) => /home|plan|meals/.test(img.src)).slice(0, 3);
---

<Base
  title={`${profile.name} — ${profile.role}`}
  description={`${profile.role}: ${profile.focus}. Портфолио проектов и контакты для заказов.`}
>
  <section class="hero">
    <div class="wrap hero-inner">
      <p class="avail"><span class="pulse"></span>{profile.available}</p>
      <h1>
        {profile.name}
        <span>{profile.role}. {profile.focus}.</span>
      </h1>
      <p class="intro">{profile.intro}</p>
      <div class="cta">
        <a class="btn btn-primary" href="#projects">Смотреть проекты</a>
        <a class="btn" href="#contact">Обсудить задачу</a>
      </div>
      <ul class="facts">
        {
          profile.facts.map((f) => (
            <li>
              <strong>{f.value}</strong>
              <span>{f.label}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section id="projects" class="section">
    <div class="wrap">
      <div class="section-head">
        <div class="eyebrow">Проекты</div>
        <h2>Системы, которые работают в продакшене</h2>
        <p>Коммерческие проекты, которые я разрабатывал в команде: ERP, маркетплейс, Service Desk. Названия заказчиков скрыты.</p>
      </div>
      <div class="grid-projects">
        {commercial.map((p, i) => <ProjectCard project={p} index={i} />)}
      </div>
    </div>
  </section>

  <section id="services" class="section alt">
    <div class="wrap">
      <div class="section-head">
        <div class="eyebrow">Услуги</div>
        <h2>Чем могу помочь</h2>
        <p>Беру задачи целиком — от разбора процесса до запуска на сервере — или отдельные части: интеграцию, интерфейс, деплой.</p>
      </div>
      <div class="grid-services">
        {
          services.map((s, i) => (
            <article class="service card">
              <span class="snum">{String(i + 1).padStart(2, '0')}</span>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section id="skills" class="section">
    <div class="wrap">
      <div class="section-head">
        <div class="eyebrow">Стек</div>
        <h2>Технологии</h2>
      </div>
      <div class="grid-skills">
        {
          skills.map((g) => (
            <div class="skill-group">
              <h3>{g.group}</h3>
              <ul class="tags">
                {g.items.map((t) => (
                  <li class="tag">{t}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section id="experience" class="section alt">
    <div class="wrap">
      <div class="section-head">
        <div class="eyebrow">Опыт и образование</div>
        <h2>Путь</h2>
      </div>
      <ol class="timeline">
        {
          experience.map((e) => (
            <li>
              <span class="period">{e.period}</span>
              <h3>{e.title}</h3>
              <p class="place">{e.place}</p>
              <ul class="bullets">
                {e.items.map((it) => (
                  <li>{it}</li>
                ))}
              </ul>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section id="academic" class="section">
    <div class="wrap">
      <div class="section-head">
        <div class="eyebrow">Учёба</div>
        <h2>Учебные проекты</h2>
        <p>Дипломная работа и проекты, сделанные во время учёбы в Astana IT University.</p>
      </div>
      {
        academicCases.map((p) => (
          <a class="ac-feature" href={withBase(`projects/${p.slug}/`)}>
            <div class="ac-info">
              <span class="ac-badge">{p.status}</span>
              <h3>{p.title}</h3>
              <p>{p.card}</p>
              <ul class="tags">
                {p.cardTags.map((t) => (
                  <li class="tag">{t}</li>
                ))}
              </ul>
              <span class="ac-more">Читать кейс →</span>
            </div>
            <div class="ac-phones" aria-hidden="true">
              {thumbsFor(p).map((img) => (
                <img src={withBase(img.src)} alt="" loading="lazy" decoding="async" />
              ))}
            </div>
          </a>
        ))
      }
      <div class="ac-grid">
        {
          academic.map((a) => (
            <article class="card ac-card">
              <h3>{a.title}</h3>
              <p>{a.text}</p>
              <ul class="tags">
                {a.tags.map((t) => (
                  <li class="tag">{t}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section id="contact" class="section">
    <div class="wrap">
      <div class="contact card">
        <div class="contact-text">
          <div class="eyebrow">Контакты</div>
          <h2>Есть задача? Напишите.</h2>
          <p>Расскажите, что нужно автоматизировать или разработать, — отвечу и предложу, как это сделать.</p>
        </div>
        <ul class="contact-list">
          <li>
            <span>Email</span>
            <a href={`mailto:${c.email}`}>{c.email}</a>
          </li>
          <li>
            <span>Телефон</span>
            <a href={c.phoneHref}>{c.phone}</a>
          </li>
          <li>
            <span>WhatsApp</span>
            <a href={c.whatsapp} target="_blank" rel="noopener">Написать в WhatsApp</a>
          </li>
          <li>
            <span>GitHub</span>
            <a href={c.github} target="_blank" rel="noopener">{c.githubLabel}</a>
          </li>
          <li>
            <span>GitLab</span>
            <a href={c.gitlab} target="_blank" rel="noopener">{c.gitlabLabel}</a>
          </li>
        </ul>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    position: relative;
    padding: 72px 0 64px;
    overflow: hidden;
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(color-mix(in srgb, var(--line) 70%, transparent) 1px, transparent 1px),
      linear-gradient(90deg, color-mix(in srgb, var(--line) 70%, transparent) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: radial-gradient(ellipse 70% 70% at 70% 30%, black, transparent 75%);
    pointer-events: none;
  }
  @media (min-width: 720px) {
    .hero {
      padding: 120px 0 104px;
    }
  }
  .hero-inner {
    position: relative;
    display: grid;
    gap: 28px;
  }
  .avail {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    justify-self: start;
    font-size: 14px;
    font-weight: 600;
    padding: 7px 14px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--surface);
  }
  .pulse {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
    flex: none;
    animation: pulse 2s ease-in-out infinite;
  }
  @keyframes pulse {
    0%,
    100% {
      box-shadow: 0 0 0 0 color-mix(in srgb, var(--accent) 50%, transparent);
    }
    50% {
      box-shadow: 0 0 0 6px transparent;
    }
  }
  h1 {
    font-size: clamp(42px, 8vw, 88px);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1;
    max-width: 14ch;
  }
  h1 span {
    display: block;
    margin-top: 18px;
    font-size: clamp(20px, 2.6vw, 28px);
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.3;
    color: var(--muted);
    max-width: 30ch;
  }
  .intro {
    font-size: 18px;
    max-width: 62ch;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .facts {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px 16px;
    max-width: 920px;
    margin-top: 12px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }
  @media (min-width: 720px) {
    .facts {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 24px;
    }
  }
  .facts li {
    display: grid;
    gap: 4px;
  }
  .facts strong {
    font-size: clamp(22px, 3.4vw, 32px);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }
  .facts span {
    font-size: 13.5px;
    color: var(--muted);
    line-height: 1.35;
  }

  .alt {
    background: var(--surface-2);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .grid-projects {
    display: grid;
    gap: 20px;
  }
  @media (min-width: 860px) {
    .grid-projects {
      grid-template-columns: 1fr 1fr;
      gap: 24px;
    }
  }

  .grid-services {
    display: grid;
    gap: 16px;
  }
  @media (min-width: 720px) {
    .grid-services {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (min-width: 1040px) {
    .grid-services {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .service {
    padding: 24px;
    display: grid;
    gap: 10px;
    align-content: start;
    box-shadow: none;
  }
  .snum {
    font-family: var(--mono);
    font-size: 13px;
    color: var(--accent);
  }
  .service h3 {
    font-size: 20px;
    font-weight: 800;
  }
  .service p {
    color: var(--muted);
  }

  .grid-skills {
    display: grid;
    gap: 28px 40px;
  }
  @media (min-width: 720px) {
    .grid-skills {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .skill-group h3 {
    font-size: 15px;
    font-weight: 700;
    margin-bottom: 12px;
  }

  .timeline {
    max-width: 760px;
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 32px;
    border-left: 2px solid var(--line);
  }
  .timeline > li {
    position: relative;
    padding-left: 24px;
    display: grid;
    gap: 6px;
  }
  .timeline > li::before {
    content: '';
    position: absolute;
    left: -7px;
    top: 4px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--bg);
    border: 2px solid var(--accent);
  }
  .period {
    font-family: var(--mono);
    font-size: 13px;
    color: var(--accent);
  }
  .timeline h3 {
    font-size: 20px;
    font-weight: 800;
  }
  .place {
    color: var(--muted);
    font-weight: 600;
    margin-bottom: 6px;
  }
  .contact {
    display: grid;
    gap: 32px;
    padding: 28px;
    background: var(--text);
    color: var(--bg);
    border-color: var(--text);
  }
  @media (min-width: 860px) {
    .contact {
      grid-template-columns: 1fr 1fr;
      padding: 48px;
      gap: 48px;
    }
  }
  .contact .eyebrow {
    color: color-mix(in srgb, var(--bg) 70%, var(--accent));
  }
  .contact h2 {
    font-size: clamp(30px, 4.5vw, 48px);
    font-weight: 800;
    margin-bottom: 14px;
  }
  .contact-text p {
    opacity: 0.75;
    font-size: 17px;
  }
  .contact-list {
    list-style: none;
    display: grid;
    align-content: center;
  }
  .contact-list li {
    display: grid;
    gap: 2px;
    padding: 14px 0;
    border-bottom: 1px solid color-mix(in srgb, var(--bg) 18%, transparent);
  }
  .contact-list li:last-child {
    border-bottom: 0;
  }
  .contact-list span {
    font-family: var(--mono);
    font-size: 12.5px;
    opacity: 0.6;
    text-transform: uppercase;
  }
  .contact-list a {
    font-size: 18px;
    font-weight: 700;
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  .contact-list a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
</style>
